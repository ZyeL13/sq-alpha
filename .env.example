# Copy to .env and fill in your own keys. Never commit .env.
# LLM providers (priority: BlockRun > Groq > NVIDIA NIM; DeepSeek off until topped up)
# BlockRun (ClawRouter) local proxy — must be running on the host (port 8402).
# Inside Docker, 127.0.0.1 is the container itself, so the compose file sets
# this to http://host.docker.internal:8402/v1/chat/completions. For a
# non-Docker run on the same machine, the default below works as-is.
BLOCKRUN_API_URL=http://127.0.0.1:8402/v1/chat/completions
# Groq Free plan (no card): https://console.groq.com/keys
GROQ_API_KEY=
# DeepSeek (pay per token, disabled until topped up): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# NVIDIA NIM free key (nvapi-, no card): https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Posting targets
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BINANCE_SQUARE_KEY=
BINANCE_SQUARE_URL=
# Market data (optional, Fase 3 langkah 4)
# CoinMarketCap Basic (free): https://coinmarketcap.com/api/
CMC_API_KEY=
